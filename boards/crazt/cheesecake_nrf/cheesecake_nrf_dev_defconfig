CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_MANUFACTURER="SlimeVR"
CONFIG_USB_DEVICE_PRODUCT="SlimeNRF Tracker CheeseCake_NRF Dev"

CONFIG_BATTERY_USE_REG_LDO_MAPPING=y
CONFIG_LED_RGB_COLOR=y
CONFIG_LED_DEFAULT_COLOR_R=0
CONFIG_LED_DEFAULT_COLOR_G=7000
CONFIG_LED_DEFAULT_COLOR_B=10000
CONFIG_LED_MAX_BRIGHTNESS=2500
CONFIG_LED_WHITE_MAX_BRIGHTNESS=1000

# Development image: no UF2 bootloader, no SoftDevice, app starts at flash base.
# CONFIG_BUILD_OUTPUT_UF2 is not set
CONFIG_FLASH_LOAD_OFFSET=0x0
